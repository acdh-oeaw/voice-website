# Build context allowlist: include only application inputs and reusable caches.
**
!package.json
!pnpm-lock.yaml
!pnpm-workspace.yaml
!astro.config.ts
!tsconfig.json
!keystatic.config.tsx

# Tailwind uses .gitignore to determine which sources to scan.
!.gitignore
!src/**
!content/**
!public/**
!scripts/prune-assets.ts

# Runtime configuration is copied separately from application sources.
!Caddyfile

# Exclude dependencies and Vite caches; reuse optimized images and fonts only.
!node_modules/.astro/assets/**
!node_modules/.astro/fonts/**
**/*.test.*
